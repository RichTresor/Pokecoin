# Normalize line endings and enforce LF for scripts to avoid shebang CRLF issues on Windows

# Default: let Git auto-detect text files
* text=auto

# Enforce LF for executable/scripts and Ruby sources
bin/* text eol=lf
*.sh   text eol=lf
*.rb   text eol=lf
Gemfile text eol=lf
Rakefile text eol=lf

# Common config files that should be LF
*.yml  text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Frontend sources (keep LF for consistent builds)
*.js   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.erb  text eol=lf
# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials
